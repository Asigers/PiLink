{
  "name": "pilink",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted autonomous AI agent powered by Pi, accessible through WeChat.",
  "type": "module",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pi.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "typebox": "1.3.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
